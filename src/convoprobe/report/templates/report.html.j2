<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>convoprobe report: {{ result.scenario_name }} ({{ result.run_id }})</title>
<style>
:root {
  --bg: #fafaf9;
  --panel: #ffffff;
  --text: #1c1917;
  --muted: #57534e;
  --border: #d6d3d1;
  --user-bg: #eff6ff;
  --user-border: #93c5fd;
  --agent-bg: #f5f5f4;
  --agent-border: #a8a29e;
  /* Status cells: the status colour as text on a soft tint of itself (about 18%). */
  --pass-bg: rgba(22, 163, 74, 0.18);
  --pass-text: #166534;
  --fail-bg: rgba(220, 38, 38, 0.18);
  --fail-text: #991b1b;
  --mixed-bg: rgba(202, 138, 4, 0.18);
  --mixed-text: #854d0e;
  --skip-bg: rgba(120, 113, 108, 0.18);
  --skip-text: #44403c;
  --cited: #dc2626;
  --code-bg: #f5f5f4;
  --link: #1d4ed8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0c0a09;
    --panel: #1c1917;
    --text: #f5f5f4;
    --muted: #a8a29e;
    --border: #44403c;
    --user-bg: #172554;
    --user-border: #3b82f6;
    --agent-bg: #292524;
    --agent-border: #78716c;
    --pass-bg: rgba(74, 222, 128, 0.18);
    --pass-text: #4ade80;
    --fail-bg: rgba(248, 113, 113, 0.18);
    --fail-text: #f87171;
    --mixed-bg: rgba(250, 204, 21, 0.18);
    --mixed-text: #facc15;
    --skip-bg: rgba(168, 162, 158, 0.18);
    --skip-text: #d6d3d1;
    --cited: #f87171;
    --code-bg: #0c0a09;
    --link: #93c5fd;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 1100px; margin: 0 auto; padding: 16px; overflow-wrap: anywhere; }
code { overflow-wrap: anywhere; word-break: break-word; }
section, details, .body, .turn, .msg, li { min-width: 0; }
h1 { font-size: 1.5rem; margin: 0 0 4px; }
h2 { font-size: 1.15rem; margin: 28px 0 8px; }
a { color: var(--link); }
.muted { color: var(--muted); }
.small { font-size: 0.85rem; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 2px 12px; margin: 12px 0; }
.meta dt { color: var(--muted); }
.meta dd { margin: 0; overflow-wrap: anywhere; }
.overall { font-size: 2.5rem; font-weight: 700; line-height: 1.1; }
.scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; background: var(--panel); }
table { border-collapse: collapse; width: 100%; }
th, td { padding: 6px 10px; border-bottom: 1px solid var(--border); text-align: right; white-space: nowrap; }
th:first-child, td:first-child { text-align: left; }
th { font-weight: 600; background: var(--agent-bg); white-space: normal; vertical-align: bottom; }
.matrix th { max-width: 9rem; overflow-wrap: anywhere; }
.matrix th > span { display: inline-block; max-width: 9rem; overflow-wrap: anywhere; }
.band-pass { background: var(--pass-bg); color: var(--pass-text); }
.band-fail { background: var(--fail-bg); color: var(--fail-text); }
.band-mixed { background: var(--mixed-bg); color: var(--mixed-text); }
.badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; }
.badge-pass { background: var(--pass-bg); color: var(--pass-text); }
.badge-fail, .badge-error { background: var(--fail-bg); color: var(--fail-text); }
.badge-skip { background: var(--skip-bg); color: var(--skip-text); }
ul.plain { list-style: none; padding: 0; margin: 0; }
ul.plain > li { padding: 6px 0; border-bottom: 1px solid var(--border); overflow-wrap: anywhere; }
details { background: var(--panel); border: 1px solid var(--border); border-radius: 6px; margin: 10px 0; }
details > summary { cursor: pointer; padding: 10px 12px; overflow-wrap: anywhere; }
details > .body { padding: 0 12px 12px; }
.turn { border-left: 3px solid transparent; padding: 6px 0 6px 10px; margin: 8px 0; }
.turn.cited { border-left-color: var(--cited); }
.turn:target { outline: 2px solid var(--link); outline-offset: 2px; }
.msg { border-radius: 6px; padding: 8px 10px; margin: 6px 0; overflow-wrap: anywhere; white-space: pre-wrap; }
.msg-user { background: var(--user-bg); border-left: 4px solid var(--user-border); }
.msg-agent { background: var(--agent-bg); border-left: 4px solid var(--agent-border); }
.who { display: block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--muted); white-space: normal; }
pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 4px; padding: 6px 8px; margin: 4px 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 0.8rem; }
footer { margin: 32px 0 16px; color: var(--muted); font-size: 0.85rem; }
</style>
</head>
<body>
<main>
<header>
<h1>convoprobe report</h1>
<div class="muted">{{ result.scenario_name }}</div>
<dl class="meta">
<dt>Run</dt><dd>{{ result.run_id }}</dd>
<dt>Adapter</dt><dd>{{ result.adapter }}</dd>
{% if result.mode %}<dt>Mode</dt><dd>{{ result.mode }}</dd>
{% endif %}
<dt>Models</dt><dd>{{ models }}</dd>
<dt>Started</dt><dd>{{ started }}</dd>
<dt>Finished</dt><dd>{{ finished }}</dd>
</dl>
<div class="muted small">Overall pass rate</div>
<div class="overall">{{ overall }}</div>
</header>

<section>
<h2>Rubric</h2>
<div class="scroll">
<table>
<thead>
<tr><th>Rubric</th><th>Source</th><th>Pass</th><th>Fail</th><th>Error</th><th>Skip</th><th>Rate</th>{% if show_stdev %}<th>±</th>{% endif %}</tr>
</thead>
<tbody>
{% for row in rubric_rows %}
<tr><td>{{ row.id }}</td><td>{{ row.source }}</td><td>{{ row.passed }}</td><td>{{ row.failed }}</td><td>{{ row.errored }}</td><td>{{ row.skipped }}</td><td class="band-{{ row.band }}">{{ row.rate }}</td>{% if show_stdev %}<td>{{ row.stdev }}</td>{% endif %}</tr>
{% endfor %}
</tbody>
</table>
</div>
</section>

{% if matrix %}
<section>
<h2>Pass rate by persona</h2>
<div class="scroll">
<table class="matrix">
<thead>
<tr><th>Persona</th>{% for rubric_id in rubric_ids %}<th><span>{{ rubric_id }}</span></th>{% endfor %}</tr>
</thead>
<tbody>
{% for row in matrix %}
<tr><td>{{ row.persona }}</td>{% for cell in row.cells %}<td class="band-{{ cell.band }}">{{ cell.text }}</td>{% endfor %}</tr>
{% endfor %}
</tbody>
</table>
</div>
</section>
{% endif %}

{% if result.notes %}
<section>
<h2>Notes</h2>
<ul class="plain">
{% for note in result.notes %}<li>{{ note }}</li>
{% endfor %}
</ul>
</section>
{% endif %}

{% if usage %}
<section>
<h2>LLM usage</h2>
<ul class="plain">
{% for line in usage %}<li class="small">{{ line }}</li>
{% endfor %}
</ul>
</section>
{% endif %}

<section>
<h2>Conversations</h2>
{% for conv in conversations %}
<details id="{{ conv.id }}"{% if conv.open %} open{% endif %}>
<summary><strong>{{ conv.id }}</strong> <span class="muted">persona {{ conv.persona_id }}, {{ conv.status }}, ended {{ conv.ended_reason }}</span>{% if conv.failed %} <span class="badge badge-fail">{{ conv.failed }} failed</span>{% endif %}</summary>
<div class="body">
{% if conv.error %}<p class="small">Error: {{ conv.error }}</p>{% endif %}
<h3 class="small muted">Checks</h3>
<ul class="plain">
{% for check in conv.checks %}
<li><span class="badge badge-{{ check.status }}">{{ check.status }}</span> <strong>{{ check.rubric_id }}</strong> <span class="muted small">{{ check.source }}{% if check.verdict %}, verdict {{ check.verdict }}{% endif %}{% if check.score is not none %}, score {{ check.score }}/5{% endif %}</span>
<div class="small">{{ check.detail }}</div>
{% if check.evidence %}
<ul class="small">
{% for ev in check.evidence %}<li><a href="{{ ev.href }}">turn {{ ev.turn }}</a>: "{{ ev.quote }}"{% if ev.found is false %} <span class="muted">(quote not found in transcript)</span>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
</li>
{% else %}
<li class="muted">No checks.</li>
{% endfor %}
</ul>
<h3 class="small muted">Transcript</h3>
{% for turn in conv.turns %}
<div class="turn{% if turn.cited %} cited{% endif %}" id="{{ turn.anchor }}">
<div class="small muted">turn {{ turn.number }}</div>
{% if turn.user is not none %}<div class="msg msg-user"><span class="who">User</span>{{ turn.user }}</div>{% endif %}
{% for agent in turn.agents %}
<div class="msg msg-agent"><span class="who">Agent</span>{{ agent.text }}</div>
{% for tool in agent.tools %}
<div class="small">Tool call: <code>{{ tool.name }}({{ tool.args }})</code></div>
<pre>{{ tool.result }}</pre>
{% endfor %}
{% if agent.latency_ms is not none or agent.node_path %}
<div class="small muted">{% if agent.latency_ms is not none %}{{ agent.latency_ms }} ms{% endif %}{% if agent.latency_ms is not none and agent.node_path %}, {% endif %}{% if agent.node_path %}nodes: {{ agent.node_path | join(" > ") }}{% endif %}</div>
{% endif %}
{% endfor %}
</div>
{% else %}
<p class="muted small">No messages.</p>
{% endfor %}
</div>
</details>
{% endfor %}
</section>

<footer>Generated by convoprobe {{ version }}.</footer>
</main>
</body>
</html>
